# Database Configuration (PostgreSQL via Supabase with PgBouncer)
DATABASE_URL="postgres://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgres://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# App Deployment URLs
NEXT_PUBLIC_APP_URL="https://aispend.vercel.app"

# Supabase Auth/Storage Configuration
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# AI Inference Providers
GROQ_API_KEY="gsk_..."

# Email Service
RESEND_API_KEY="re_..."

# Serverless Cache (Upstash Redis)
UPSTASH_REDIS_URL="https://[PROJECT_NAME].upstash.io"
UPSTASH_REDIS_TOKEN="your-upstash-redis-token"

# Analytics and Observability
POSTHOG_KEY="phc_..."
SENTRY_DSN="https://[DSN]@o[ORG].ingest.sentry.io/[PROJECT]"

# Runtime Environment
NODE_ENV="production" # development | production | test
